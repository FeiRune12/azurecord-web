# Defina como variáveis de ambiente do servidor, nunca no renderer ou no ZIP.
AZURECORD_HOST=127.0.0.1
AZURECORD_PORT=4317
AZURECORD_AI_PROVIDER=openai
AZURECORD_OPENAI_API_KEY=
AZURECORD_AI_MODEL=gpt-5-mini
AZURECORD_AI_BASE_URL=https://api.openai.com/v1
AZURECORD_AI_MAX_OUTPUT=4500
AZURECORD_AI_REASONING=low
AZURECORD_AI_CONTEXT_MESSAGES=84
AZURECORD_AI_WEB_SEARCH=false
AZURECORD_AI_MEMORY_REFRESH=true
# AzurePoints: nenhuma transferência ocorre automaticamente.
# Conversão ilustrativa: 100 AP = R$ 1,00, somente se o programa for habilitado.
AZURECORD_POINTS_PER_BRL=100
AZURECORD_POINTS_MIN_REDEEM=500
AZURECORD_POINTS_CASHOUT_ENABLED=false
AZURECORD_POINTS_ADMIN_EMAIL=
AZURECORD_POINTS_ADMIN_KEY=
# Administrador da coleta de feedback
AZURECORD_BETA_ADMIN_EMAIL=
# No cliente Electron, URL HTTPS de um backend compartilhado:
# AZURECORD_BACKEND_URL=https://seu-servidor.exemplo
# Esta URL também pode ser definida no arquivo %APPDATA%\azurecord-desktop\backend\.env
# Copie os dados do backend ORIGINAL antes de instalar uma versão nova.
